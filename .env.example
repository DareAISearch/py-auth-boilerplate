# The IAM service every capability in this package trusts. Required always: its JWKS is derived
# as <IAM_SERVICE_URL>/.well-known/jwks.json (used for inbound verification, so this is needed
# even by a service that never mints its own outbound tokens), and its /token endpoint is used
# for outbound M2M minting.
IAM_SERVICE_URL=https://iam.example.com

# This service's own identity: the audience it expects on inbound tokens (checked against `aud`
# when verifying), and the subject it identifies itself as when minting its own outbound tokens
# (sent automatically as `sub` -- you never pass it yourself when calling get_token()).
SERVICE_NAME=your-service-name

JWKS_CACHE_TTL_SECONDS=900
TOKEN_CACHE_MAX_TTL_SECONDS=300
# Leeway (seconds) applied to exp/nbf/iat checks. 0 = strict, matches PyJWT's own default.
CLOCK_TOLERANCE_SECONDS=0

# Outbound OAuth2 client credentials -- optional: a service that only verifies inbound tokens
# (never calls create_token_provider) can leave these unset. load_auth_config_from_env() won't
# fail without them; get_token() throws a clear error if you try to actually issue a token
# without them set.
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
OUTBOUND_TOKEN_MAX_TTL_SECONDS=3600
OUTBOUND_TOKEN_SAFETY_MARGIN_SECONDS=30

# Only needed if you use the bundled RedisCache instead of supplying your own Cache implementation.
REDIS_URL=redis://localhost:6379
